# SUTRA Backend Configuration
SUTRA_ENV=development
SUTRA_HOST=0.0.0.0
SUTRA_PORT=8000
SUTRA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite / Relational DB
SUTRA_DATABASE_URL=sqlite:///./sutra.db

# MongoDB Configuration
SUTRA_MONGODB_URL=mongodb://localhost:27017
SUTRA_MONGODB_DB=sutra_db
SUTRA_MONGODB_ENABLED=true
SUTRA_MONGODB_TIMEOUT_MS=3000

# AI Vision Engine Location & Subprocess Supervisor
SUTRA_AI_ENGINE_DIR=../sutra-ai-engine
SUTRA_PROTOCOL_PATH=protocols/demo_wetlab.yaml

# Security & Traffic Controls
SUTRA_DEV_AUTH=true
SUTRA_MAX_REQUEST_BYTES=1048576
SUTRA_RATE_LIMIT_PER_MINUTE=120
